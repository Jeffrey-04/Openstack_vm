# Copiez ce fichier en .env à la racine de Frontend/

# URL de l'API (sans /api à la fin - le front appelle /api/...)
# En dev avec proxy: http://localhost:3001
# En prod derrière Nginx: https://votredomaine.com ou http://VOTRE_IP
REACT_APP_API_URL=http://localhost:3001

# Port du serveur de développement (optionnel)
PORT=3000

# OAuth (optionnel – quand le backend exposera une route de connexion Google)
# REACT_APP_GOOGLE_CLIENT_ID=
