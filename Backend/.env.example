# Copiez ce fichier en .env dans le dossier Backend/

# OpenStack
OS_USERNAME=admin
OS_PASSWORD=YourSecurePassword123!
OS_PROJECT_NAME=admin
KEYSTONE_URL=http://YOUR_VPS_IP/identity/v3
NOVA_URL=http://YOUR_VPS_IP:8774/v2.1
GLANCE_URL=http://YOUR_VPS_IP:9292
NEUTRON_URL=http://YOUR_VPS_IP:9696

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Auth (obligatoire en production)
JWT_SECRET=change-me-use-a-long-random-string-in-production

# OAuth (optionnel – décommenter quand le backend supporte Google)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Database (optionnel - SQLite utilisé si non défini)
# DATABASE_URL=postgresql://user:password@localhost:5432/vmmarketplace
# Pour dev sans PostgreSQL, ne pas définir DATABASE_URL (SQLite sera utilisé)
# SQLITE_PATH=./database.sqlite
# SQL_LOG=false
