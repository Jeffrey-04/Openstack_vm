# Copiez ce fichier en .env dans le dossier Backend/

# OpenStack (URLs exposées par Apache sur le port 80 - Accès API du dashboard)
# Remplacer 45.9.191.91 par votre IP/hostname si différent.
OS_USERNAME=admin
OS_PASSWORD=YourSecurePassword123!
OS_PROJECT_NAME=admin
KEYSTONE_URL=http://45.9.191.91/identity/v3
NOVA_URL=http://45.9.191.91/compute/v2.1
GLANCE_URL=http://45.9.191.91/image
NEUTRON_URL=http://45.9.191.91/networking


# Auth (obligatoire en production)
JWT_SECRET=cle_aleatoire_pour_le_jwt


# Database
# DATABASE_URL=postgresql://user:password@localhost:5432/vmmarketplace
# Pour dev sans PostgreSQL, ne pas définir DATABASE_URL (SQLite sera utilisé)
# SQLITE_PATH=./database.sqlite
# SQL_LOG=false
# DB_ALTER=true pour appliquer les changements de schéma au démarrage (éviter avec SQLite si erreur UNIQUE)
# KEYSTONE_MULTI_TENANT=true pour créer un projet Keystone par utilisateur à l'inscription (isolation multi-tenant)
# Ceilometer (optionnel - historique métriques brut, utilisé comme pipeline vers Gnocchi)
# CEILOMETER_URL=http://45.9.191.91:8777

# Gnocchi (stockage séries temporelles - recommandé pour les métriques CPU/RAM/disque)
# GNOCCHI_URL=http://45.9.191.91:8041
# GNOCCHI_TIMEOUT_MS=12000
# GNOCCHI_RETRIES=1
# GNOCCHI_ERROR_THROTTLE_MS=60000
# OPENSTACK_CACHE_TTL_MS=30000
# OPENSTACK_TIMEOUT_MS=15000

# noVNC console (optionnel mais recommandé)
# NOVA_CONSOLE_MICROVERSION=2.6
# NOVNC_PUBLIC_BASE_URL=http://45.9.191.91:6080

# Streaming métriques live (SSE)
# METRICS_STREAM_INTERVAL_MS=10000
# BILLING_OVERDUE_AFTER_DAYS=7

# Rate-limit (important derrière Nginx/Proxy)
# TRUST_PROXY_HOPS=1
# AUTH_RATE_LIMIT_WINDOW_MS=3600
# AUTH_RATE_LIMIT_MAX=60
# AUTH_RATE_LIMIT_SKIP_SUCCESS=true
# API_RATE_LIMIT_WINDOW_MS=3600
# API_RATE_LIMIT_MAX=1820000

# Aodh (alarmes - optionnel, utilisé directement par OpenStack plutôt que par le backend Node)
# AODH_URL=http://45.9.191.91:8042
